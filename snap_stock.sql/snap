{% snapshot snap_stock %}

{{
    config(
        target_database='DEV_PROYECTO_GOLD',
        target_schema='SNAPSHOTS',
        unique_key='id_stock',
        strategy='check',
        check_cols=['stock_actual', 'unidades_vendidas']
    )
}}

select
    id_stock,
    id_libro,
    stock_inicial,
    unidades_vendidas,
    stock_actual,
    fecha_actualizacion,
    necesita_reposicion
from {{ ref('stg_stock') }}

{% endsnapshot %}